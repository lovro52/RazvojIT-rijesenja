# Copy this file to .env and adjust local paths or model names as needed.
OLLAMA_MODEL=llama3.1:8b
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=data/chroma
UPLOAD_DIR=data/uploads
DB_PATH=data/logs.db
MODEL_DIR=data/models

# Resource limits
MAX_UPLOAD_BYTES=262144000
MAX_NORMALIZED_ROWS=5000
MAX_QUERY_LENGTH=1000
MAX_TOP_K=50
MAX_COMPARE_MODELS=3

# Cosine score used only as an explicit retrieval cut-off, not a probability.
MIN_RETRIEVAL_SIMILARITY=0.15
